{
  "name": "vapormesh",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A web-based 3D modeler and layout tool in the spirit of mid-90s software, with a vaporwave look, in TypeScript",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
